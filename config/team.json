{
  "model_registry": {
    "gpt-6.1-terra": {
      "cli": "codex",
      "backend": "openai",
      "aliases": [
        "terra",
        "gpt6"
      ]
    },
    "gpt-6-luna": {
      "cli": "codex",
      "backend": "openai",
      "aliases": [
        "luna"
      ]
    },
    "gpt-6.1-sol": {
      "cli": "codex",
      "backend": "openai",
      "aliases": [
        "sol"
      ]
    },
    "deepseek-v4.1-flash": {
      "cli": "deepseek",
      "backend": "deepseek",
      "aliases": [
        "deepseek",
        "ds"
      ],
      "note": "需要本机装 deepseek CLI"
    },
    "claude-opus-5-5": {
      "cli": "claude",
      "backend": "anthropic",
      "aliases": [
        "claude",
        "opus"
      ],
      "note": "需要本机装 claude CLI"
    },
    "claude-sonnet-5": {
      "cli": "codex",
      "backend": "openai",
      "note": "需要 room/model_providers.json 给这个型号配可达端点"
    },
    "claude-opus-4-8": {
      "cli": "codex",
      "backend": "openai",
      "note": "需要 room/model_providers.json 给这个型号配可达端点"
    }
  },
  "executor": {
    "model": "gpt-6.1-terra",
    "reasoning_effort": "low",
    "timeout": 1800,
    "sandbox": "workspace-write",
    "fallback_models": [
      "gpt-6.1-sol",
      "gpt-6-luna"
    ]
  },
  "reviewer": {
    "model": "gpt-6-luna",
    "reasoning_effort": "low",
    "timeout": 600,
    "sandbox": "read-only",
    "fallback_models": [
      "claude-sonnet-5"
    ]
  },
  "agents": [
    {
      "role": "coordinator",
      "name": "协调",
      "model": "gpt-6.1-terra",
      "effort": "low",
      "sandbox": "read-only",
      "enabled": true
    },
    {
      "role": "planner",
      "name": "规划",
      "model": "gpt-6.1-terra",
      "effort": "low",
      "sandbox": "read-only",
      "enabled": true
    },
    {
      "role": "executor",
      "name": "执行",
      "model": "gpt-6.1-terra",
      "effort": "low",
      "sandbox": "workspace-write",
      "enabled": true
    },
    {
      "role": "tester",
      "name": "验收",
      "model": "gpt-6.1-terra",
      "effort": "low",
      "sandbox": "workspace-write",
      "enabled": true
    },
    {
      "role": "reviewer",
      "name": "复核",
      "model": "gpt-6-luna",
      "effort": "low",
      "sandbox": "read-only",
      "enabled": true
    }
  ],
  "policy": {
    "require_approval": false
  }
}
